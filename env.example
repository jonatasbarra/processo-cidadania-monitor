# .env.example
#
# PT: Copie este arquivo para ".env" e preencha com seus dados REAIS.
#     O arquivo ".env" está no .gitignore e NUNCA deve ser commitado.
#
# EN: Copy this file to ".env" and fill in your REAL data.
#     The ".env" file is in .gitignore and should NEVER be committed.
#
# Como usar / How to use:
#   cp .env.example .env
#   # edite .env com seus valores reais / edit .env with your real values

# ── Gmail ───────────────────────────────────────────────────────────────────
# PT: Seu endereço Gmail (usado para enviar E RECEBER o e-mail)
# EN: Your Gmail address (used to send AND receive the email)
GMAIL_USER=seu_email@gmail.com

# PT: Senha de App do Google (NÃO é sua senha normal do Gmail).
#     Como gerar: https://myaccount.google.com/apppasswords
#     Requisito: ter verificação em 2 etapas ativada na conta Google.
# EN: Google App Password (NOT your regular Gmail password).
#     How to generate: https://myaccount.google.com/apppasswords
#     Requirement: have 2-step verification enabled on your Google account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# PT: E-mail que receberá as notificações (pode ser o mesmo do GMAIL_USER)
# EN: Email that will receive notifications (can be the same as GMAIL_USER)
NOTIFY_EMAIL=seu_email@gmail.com

# ── Processo / Case ─────────────────────────────────────────────────────────
CASE_NUMBER=3702
CASE_YEAR=2024
